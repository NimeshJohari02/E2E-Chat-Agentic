            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/queue/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "queue", "assign"]
            },
            "description": "Assign the next conversation from queue to the current agent.\n\n**Note:** Uses pessimistic locking to prevent race conditions."
          },
          "response": []
        },
