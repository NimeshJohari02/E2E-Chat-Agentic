            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/faqs/import",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "faqs", "import"]
            },
            "description": "Bulk import FAQs from JSON."
          },
          "response": []
        },
        {
          "name": "Export FAQs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/faqs/export",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "faqs", "export"]
            },
            "description": "Export all FAQs as JSON for backup or migration."
