            "description": "Interactive Swagger UI documentation for all API endpoints."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Authentication and authorization endpoints. JWT-based authentication system.",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"name\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "auth", "register"]
            },
            "description": "Register a new user account.\n\n**Password Requirements:**\n- Minimum 8 characters\n- At least 1 uppercase letter\n- At least 1 number\n- At least 1 special character"
          },
          "response": [
            {
              "name": "Success",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"id\": \"uuid-here\",\n  \"email\": \"user@example.com\",\n  \"name\": \"John Doe\",\n  \"createdAt\": \"2026-01-13T12:00:00.000Z\"\n}"
            },
            {
              "name": "Email Already Exists",
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"statusCode\": 409,\n  \"message\": \"Email already registered\",\n  \"error\": \"Conflict\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set('accessToken', jsonData.accessToken);",
                  "    pm.environment.set('refreshToken', jsonData.refreshToken);",
                  "    console.log('Tokens saved to environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "auth", "login"]
            },
            "description": "Authenticate user and receive JWT tokens.\n\n**Response tokens are automatically saved to environment variables.**"
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refreshToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"expiresIn\": 3600\n}"
            },
            {
              "name": "Invalid Credentials",
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"statusCode\": 401,\n  \"message\": \"Invalid credentials\",\n  \"error\": \"Unauthorized\"\n}"
            }
          ]
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set('accessToken', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "auth", "refresh"]
            },
            "description": "Refresh expired access token using refresh token."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "auth", "logout"]
            },
            "description": "Invalidate current session and tokens."
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "auth", "me"]
            },
            "description": "Get current authenticated user's profile information."
          },
          "response": []
        }
      ]
    },
    {
      "name": "FAQ (L0)",
      "description": "L0 Static Query Engine - FAQ matching with exact, semantic, and fuzzy search.",
      "item": [
        {
          "name": "Query FAQ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What are your business hours?\",\n  \"category\": \"general\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/query",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "query"]
            },
            "description": "Query the FAQ database using hybrid search.\n\n**Search Strategy (in order):**\n1. **Exact Match** - Keyword matching (fastest)\n2. **Semantic Search** - pgvector embeddings (most accurate)\n3. **Fuzzy Match** - ILIKE fallback\n\n**Parameters:**\n- `query` (required): The user's question\n- `category` (optional): Filter by category"
          },
          "response": [
            {
              "name": "Match Found",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"id\": \"faq-uuid\",\n  \"question\": \"What are your business hours?\",\n  \"answer\": \"We are open Monday to Friday, 9 AM to 6 PM.\",\n  \"category\": \"general\",\n  \"confidence\": 0.95,\n  \"matchType\": \"semantic\"\n}"
            },
            {
              "name": "No Match (Escalate to L1)",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "null"
            }
          ]
        },
        {
          "name": "Get All FAQs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/faqs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "faqs"]
            },
            "description": "Retrieve all FAQs ordered by category and priority.\n\n**Note:** Results are cached for 5 minutes (Redis if available, in-memory otherwise)."
          },
          "response": []
        },
        {
          "name": "Get FAQ by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/faqs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "faqs", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "faq-uuid-here",
                  "description": "FAQ UUID"
                }
              ]
            },
            "description": "Get a specific FAQ by its ID."
          },
          "response": []
        },
        {
          "name": "Create FAQ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How do I reset my password?\",\n  \"answer\": \"Click on 'Forgot Password' on the login page and follow the instructions.\",\n  \"category\": \"account\",\n  \"priority\": 10,\n  \"keywords\": [\"password\", \"reset\", \"forgot\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/faqs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "faqs"]
            },
            "description": "Create a new FAQ entry.\n\n**Note:** Embeddings are automatically generated for semantic search."
          },
          "response": []
        },
        {
          "name": "Update FAQ",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answer\": \"Updated answer here\",\n  \"priority\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/faqs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "faqs", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "faq-uuid-here"
                }
              ]
            },
            "description": "Update an existing FAQ. Only provided fields are updated."
          },
          "response": []
        },
        {
          "name": "Delete FAQ",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/faqs/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "faqs", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "faq-uuid-here"
                }
              ]
            },
            "description": "Soft delete an FAQ (marks as inactive)."
          },
          "response": []
        },
        {
          "name": "Import FAQs (Bulk)",
