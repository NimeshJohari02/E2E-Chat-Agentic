    {
      "name": "Chat (L1)",
      "description": "L1 AI Chatbot - Intelligent conversation with LLM providers (OpenAI, Anthropic, Groq).",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"message\": \"I need help with my order\",\n  \"context\": {\n    \"orderId\": \"ORD-12345\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "chat"]
            },
            "description": "Send a message to the AI chatbot.\n\n**Flow:**\n1. System first checks L0 (FAQ) for a match\n2. If no FAQ match, routes to L1 (AI)\n3. AI generates response with conversation context\n4. If AI confidence low, can escalate to L2 (Agent)\n\n**Parameters:**\n- `sessionId`: Unique session identifier (auto-generated if not provided)\n- `message`: User's message\n- `context` (optional): Additional context for the AI"
          },
          "response": [
            {
              "name": "AI Response",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"sessionId\": \"session-uuid\",\n  \"response\": \"I'd be happy to help with your order ORD-12345. What seems to be the issue?\",\n  \"source\": \"ai\",\n  \"model\": \"gpt-4\",\n  \"tokensUsed\": 150,\n  \"shouldEscalate\": false\n}"
            }
          ]
        },
        {
          "name": "Get Session History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/chat/session/:sessionId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "chat", "session", ":sessionId"],
              "variable": [
                {
                  "key": "sessionId",
                  "value": "{{sessionId}}",
                  "description": "Chat session ID"
                }
              ]
            },
            "description": "Retrieve conversation history for a session.\n\n**Note:** Only the last 10 messages are kept in context (sliding window)."
          },
          "response": []
        },
        {
          "name": "Escalate to Agent (L2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"reason\": \"Customer requested human agent\",\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/chat/escalate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "chat", "escalate"]
            },
            "description": "Manually escalate a conversation to a human agent (L2).\n\n**Triggers:**\n- User explicitly requests an agent\n- AI confidence below threshold\n- Sensitive topics detected"
          },
          "response": []
        },
        {
          "name": "Model Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/models/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "models", "health"]
            },
            "description": "Check health status of all configured AI providers."
          },
          "response": []
        },
        {
          "name": "Switch Model Provider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"anthropic\",\n  \"model\": \"claude-3-opus\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/models/switch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "models", "switch"]
            },
            "description": "Switch the active AI model provider.\n\n**Available Providers:**\n- `openai` (gpt-4, gpt-3.5-turbo)\n- `anthropic` (claude-3-opus, claude-3-sonnet)\n- `groq` (mixtral-8x7b)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Agents (L2)",
      "description": "L2 Agent Management - Queue, assignment, and human agent operations.",
      "item": [
