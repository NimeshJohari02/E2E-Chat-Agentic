          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/queue/position/:conversationId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "queue", "position", ":conversationId"],
              "variable": [
