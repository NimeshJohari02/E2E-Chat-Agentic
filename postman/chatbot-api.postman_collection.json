              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/agents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "agents"]
            },
            "description": "Get list of all registered agents (admin only)."
          },
          "response": []
        },
        {
          "name": "Get Online Agents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/agents/online",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "agents", "online"]
            },
            "description": "Get list of currently online agents."
          },
          "response": []
