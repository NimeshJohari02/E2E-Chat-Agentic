{
  "info": {
    "_postman_id": "chatbot-backend-api-collection",
    "name": "Chatbot Backend API",
    "description": "Comprehensive API collection for the 3-tier Chatbot Support System.\n\n## Tiers\n- **L0 (FAQ)**: Static query matching\n- **L1 (Chat)**: AI-powered conversations\n- **L2 (Agent)**: Human agent handoff\n\n## Authentication\nMost endpoints require JWT authentication. Use the Auth endpoints to obtain a token.\n\n## Base URL\n- **Development**: `http://localhost:8090`\n- **Production**: Configure in environment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090",
      "type": "string"
    },
    {
      "key": "apiVersion",
      "value": "v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & System",
      "description": "System health and observability endpoints",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns application health status, version, and uptime information."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/health",
                  "host": ["{{baseUrl}}"],
                  "path": ["health"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"ok\",\n  \"version\": \"0.0.1\",\n  \"timestamp\": \"2026-01-13T12:00:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["metrics"]
            },
            "description": "Returns Prometheus-formatted metrics for monitoring.\n\n**Metrics Include:**\n- `chatbot_active_conversations_total`\n- `chatbot_queue_depth`\n- `chatbot_api_request_duration_seconds`\n- Default Node.js metrics (CPU, memory, etc.)"
          },
          "response": []
        },
        {
          "name": "Swagger Docs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/docs",
