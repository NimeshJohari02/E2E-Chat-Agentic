          "name": "Agent Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set('agentToken', jsonData.token);",
                  "    pm.environment.set('agentId', jsonData.id);",
                  "}"
